{
  "name": "iron-glove-server",
  "private": true,
  "version": "0.1.0",
  "description": "IRON GLOVE SpacetimeDB module (TypeScript, runs on V8)",
  "type": "module",
  "scripts": {
    "build": "spacetime build",
    "publish:local": "spacetime publish iron-glove --server local -y",
    "publish": "spacetime publish iron-glove --server maincloud -y",
    "generate": "spacetime generate --lang typescript --out-dir ../client/src/module_bindings -y"
  },
  "dependencies": {
    "spacetimedb": "2.10.*"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
