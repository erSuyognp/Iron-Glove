# Copy this file to .env and fill in your real values.
# .env is git-ignored so your secrets never get committed.
#
# Only VITE_* variables are bundled into the browser build. Anything else
# stays on the machine running `vite dev`.

# Cesium Ion access token (required for terrain + Google Photorealistic 3D Tiles)
# Get one free at https://ion.cesium.com/tokens
VITE_CESIUM_TOKEN=your_cesium_ion_token

# Optional: stream the same Google 3D Tiles directly from Google (Google billing)
# VITE_GOOGLE_MAPS_API_KEY=

# --- Phase 2: SpacetimeDB (multiplayer state) ---
# Local dev defaults if unset: ws://127.0.0.1:3000 and db name "iron-glove".
VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB_NAME=iron-glove

# --- Environmental intelligence: NASA FIRMS (WORLD 02, ?world=california-wildfire) ---
# Default 'demo' uses the real, bundled, HISTORICAL DEMO dataset
# (src/environmental/data/). 'live' asks the local proxy below for current
# detections and falls back to the demo dataset if that fails.
# VITE_FIRMS_MODE=demo
# Same-origin proxy base the client calls in live mode (default /api/firms).
# VITE_FIRMS_PROXY_URL=/api/firms
# Day range for live requests, 1–10 (default 2).
# VITE_FIRMS_DAYS=2

# FIRMS MAP_KEY — server-side only, read by vite.config.js for the dev proxy.
# Deliberately NOT prefixed with VITE_: it must never reach the browser.
# Get one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Production live mode needs a real server-side proxy (Vercel Function,
# Cloudflare Worker, backend); the Vite dev proxy does not ship in `vite build`.
FIRMS_MAP_KEY=

# --- Phase 4+ (not used yet) ---
# VITE_GROK_API_KEY=your_grok_api_key
