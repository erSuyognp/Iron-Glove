# Copy this file to .env and fill in your real values.
# .env is git-ignored so your secrets never get committed.

# Cesium Ion access token (required for terrain + Google Photorealistic 3D Tiles)
# Get one free at https://ion.cesium.com/tokens
VITE_CESIUM_TOKEN=your_cesium_ion_token

# --- Phase 2: SpacetimeDB (multiplayer state) ---
# Local dev defaults if unset: ws://127.0.0.1:3000 and db name "iron-glove".
VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB_NAME=iron-glove


# --- Audio: ElevenLabs (optional) ---
# JARVIS's voice and the recorded sound effects are generated by the dev server
# (vite.config.js) and saved under public/voice and public/sfx. No VITE_ prefix:
# this key stays on the server and is never put in the browser bundle. Without
# it the game uses its built-in synth and the browser's own voice.
ELEVENLABS_API_KEY=
# Optional: who speaks. A voice name from your ElevenLabs "My Voices", or a
# voice id (default: Tony). A Voice Library voice must be added to My Voices
# first. Changing it clears the saved lines in public/voice.
# ELEVENLABS_VOICE=Tony

# --- Talking to JARVIS: Grok / xAI (optional) ---
# Press T in flight and speak. The dev server (vite.config.js, /api/jarvis)
# sends what you said to Grok and gets back a reply and an action. No VITE_
# prefix: the key stays on the server. Without it a built-in phrase matcher
# still handles the commands; only the conversation needs Grok.
GROK_API_KEY=
# Optional: which model answers (default: grok-4-fast-non-reasoning).
# GROK_MODEL=
